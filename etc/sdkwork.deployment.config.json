{
  "schemaVersion": 1,
  "kind": "sdkwork.deployment-index",
  "application": "sdkwork-manager",
  "topology": "../specs/topology.spec.json",
  "defaultProfile": "standalone.development",
  "environments": {
    "development": {
      "applicationOrigin": "https://manager-dev.sdkwork.com",
      "cloudApiBaseUrl": "https://api-dev.sdkwork.com"
    },
    "test": {
      "applicationOrigin": "https://manager-test.sdkwork.com",
      "cloudApiBaseUrl": "https://api-test.sdkwork.com"
    },
    "staging": {
      "applicationOrigin": "https://manager-staging.sdkwork.com",
      "cloudApiBaseUrl": "https://api-staging.sdkwork.com"
    },
    "production": {
      "applicationOrigin": "https://manager.sdkwork.com",
      "cloudApiBaseUrl": "https://api.sdkwork.com"
    }
  },
  "profiles": {
    "standalone.development": { "config": "deployments/standalone.development.env" },
    "standalone.test": { "config": "deployments/standalone.test.env" },
    "standalone.staging": { "config": "deployments/standalone.staging.env" },
    "standalone.production": { "config": "deployments/standalone.production.env" },
    "cloud.development": { "config": "deployments/cloud.development.env" },
    "cloud.test": { "config": "deployments/cloud.test.env" },
    "cloud.staging": { "config": "deployments/cloud.staging.env" },
    "cloud.production": { "config": "deployments/cloud.production.env" }
  }
}
